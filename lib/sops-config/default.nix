{lib, ...}: {
  # nix-secrets' .sops.yaml: who reads each secret file. hosts is the flake's
  # nixosConfigurations and secrets a nix-secrets checkout. A function, so
  # that it is only evaluated when sys secrets-sync calls it, not whenever lib is
  sopsConfig = {
    hosts,
    secrets,
  }: let
    # Read every secret: with them, sys secrets-sync and add-host re-encrypt
    # files for new hosts, through the sops key service
    admins = ["filippo" "backup"];

    # The age key of a person, a host or the backup, in keys/<name>
    keyFile = name: "${secrets}/keys/${name}";
    hasKey = name: builtins.pathExists (keyFile name);
    key = name: lib.trim (builtins.readFile (keyFile name));

    hostNames = lib.attrNames hosts;

    hostSecrets = host: lib.attrValues hosts.${host}.config.sops.secrets;

    # Whether a host reads a file, such as secrets/wifi.yaml
    reads = file: host: lib.any (secret: lib.hasSuffix "/${file}" (toString secret.sopsFile)) (hostSecrets host);

    # Who reads one file. Names with no key in keys/ yet are left out
    rule = file: readers: {
      inherit file;
      readers = lib.filter hasKey (lib.unique readers);
    };

    # The files directly in secrets/, which several hosts can read: those
    # there, and those a host declares, so that sops can create them
    entries = builtins.readDir "${secrets}/secrets";
    existingFiles = map (name: "secrets/${name}") (lib.attrNames (lib.filterAttrs (_: type: type == "regular") entries));
    declaredFile = secret: builtins.match ".*/(secrets/[^/]+)" (toString secret.sopsFile);
    declaredFiles = lib.concatMap (secret: lib.defaultTo [] (declaredFile secret)) (lib.concatMap hostSecrets hostNames);
    sharedFiles = lib.unique (existingFiles ++ declaredFiles);
    sharedRule = file: rule file (admins ++ lib.filter (reads file) hostNames);

    # A host with a key has its own secrets and its stored SSH key
    hostRules = host: [
      (rule "secrets/${host}/secrets.yaml" (admins ++ [host]))
      (rule "secrets/${host}/ssh-host-key.yaml" admins)
    ];

    rules = map sharedRule sharedFiles ++ lib.concatMap hostRules (lib.filter hasKey hostNames);

    toYaml = rule: ''
      - path_regex: ^${lib.escapeRegex rule.file}$
        key_groups:
          - age:
      ${lib.concatMapStrings (name: "        - ${key name} # ${name}\n") rule.readers}'';
  in {
    inherit rules;
    yaml = ''
      # Generated by nix-config (lib/sops-config): change who reads what there, then run sys secrets-sync
      creation_rules:
      ${lib.concatMapStrings toYaml rules}'';
  };
}
